---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import CommitGraph from "@/components/CommitGraph.astro";
import Subscribe from "@/components/Subscribe.astro";
import NamePronunciation from "@/components/NamePronunciation.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.slice(0, 3);
const homePath = getRelativeLocaleUrl(locale, "");

const linkButtons = [
  { icon: "🎤", label: "Speaking", href: "/speaking/" },
  { icon: "💻", label: "Projects", href: "/projects/" },
  { icon: "💬", label: "Blog", href: "/posts/" },
  { icon: "📄", label: "Resume", href: "/resume/" },
  { icon: "🖋️", label: "Fountain Pens", href: "https://pens.alexo.dev" },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section class="border-border flex flex-col items-center border-b pt-8 pb-6 text-center">
      <img
        src="/assets/uploads/headshot-web.jpeg"
        alt="Alex Oladele"
        width="160"
        height="160"
        class="mb-4 size-40 rounded-full object-cover"
        loading="eager"
      />
      <h1 class="text-3xl font-bold sm:text-4xl">Alex Oladele <NamePronunciation /></h1>
      <p class="mt-1 text-sm opacity-60">
        <a href="https://pronouns.org/he-him" class="hover:underline">he/him</a>
      </p>
      <p class="mt-1 text-lg opacity-75">Tech nerd on the internet!</p>
      <div class="mt-4">
        <Socials />
      </div>
      <p class="mx-auto mt-4 max-w-lg opacity-85">
        Senior software engineer at Red Hat, working on Ansible Galaxy. I
        speak at conferences, build side projects, and write about
        programming, homelab adventures, and productivity experiments.
      </p>
    </section>

    <section class="border-border border-b py-6">
      <div class="mx-auto flex max-w-2xl flex-wrap justify-center gap-3">
        {
          linkButtons.map(({ icon, label, href }) => (
            <a
              href={href}
              class="group border-border bg-background hover:bg-muted/30 hover:border-accent/40 flex min-w-24 flex-col items-center gap-1.5 rounded-xl border px-5 py-4 text-center font-medium transition-all duration-200 hover:-translate-y-1 hover:shadow-lg"
            >
              <span
                aria-hidden="true"
                class="text-2xl transition-transform duration-200 group-hover:scale-125 group-hover:-rotate-6"
              >
                {icon}
              </span>
              <span class="text-sm">{label}</span>
            </a>
          ))
        }
      </div>
    </section>

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="border-border border-b py-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
          <div class="mt-4 text-center">
            <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
              {t.home.allPosts}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
          <Subscribe class="mt-6" />
        </section>
      )
    }

    <section class="py-6">
      <h2 class="mb-4 text-2xl font-semibold tracking-wide">GitHub Activity</h2>
      <a
        href="https://github.com/dragid10"
        target="_blank"
        rel="noopener noreferrer"
        class="flex justify-center transition-opacity hover:opacity-80"
      >
        <CommitGraph />
      </a>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
