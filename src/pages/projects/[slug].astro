---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconGitHub from "@/assets/icons/socials/github.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { statusColors } from "@/utils/projectStatus";
import config from "@/config";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<"projects"> };

const { project } = Astro.props;
const {
  title,
  description,
  repo,
  demo,
  post,
  status,
  tags,
  stack,
  screenshots,
} = project.data;
const { Content } = await render(project);
const hasBody = Boolean(project.body?.trim());

const isExternal = (url: string) => /^https?:\/\//.test(url);
const links = [
  repo && { href: repo, label: "Source code", icon: "github" },
  demo && {
    href: demo,
    label: isExternal(demo) ? "Visit project" : "Read the write-up",
    icon: "arrow",
  },
  post && { href: post, label: "Read the write-up", icon: "arrow" },
].filter(Boolean) as { href: string; label: string; icon: string }[];

const ogImage = screenshots[0]
  ? new URL(screenshots[0].src, Astro.url.origin).href
  : undefined;
---

<Layout
  title={`${title} | Projects | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
>
  <Header />

  <div class="app-layout flex items-center justify-start">
    <LinkButton
      href="/projects/"
      class="focus-outline hover:text-foreground/75 -ms-2 mt-8 mb-2"
    >
      <IconChevronLeft class="inline-block size-6 rtl:rotate-180" />
      <span>All projects</span>
    </LinkButton>
  </div>

  <main id="main-content" class="app-layout pb-8">
    <header class="mb-6">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-accent text-2xl font-bold sm:text-3xl">{title}</h1>
        <span
          class:list={[
            "rounded-full px-2 py-0.5 text-xs font-medium",
            statusColors[status] ?? statusColors.active,
          ]}
        >
          {status}
        </span>
      </div>
      {hasBody && <p class="mt-2 opacity-75">{description}</p>}
    </header>

    <div
      class:list={[
        "grid gap-6",
        {
          "sm:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]": screenshots.length > 0,
        },
      ]}
    >
      {
        screenshots.length > 0 && (
          <section aria-label="Screenshots" data-gallery>
            <figure>
              <div class="border-border bg-muted/20 flex aspect-[4/5] items-center justify-center overflow-hidden rounded-lg border">
                <img
                  data-gallery-main
                  src={screenshots[0].src}
                  alt={screenshots[0].alt}
                  class="max-h-full max-w-full object-contain"
                />
              </div>
              <figcaption
                data-gallery-caption
                class:list={[
                  "mt-2 text-center text-sm opacity-75",
                  { hidden: !screenshots[0].caption },
                ]}
              >
                {screenshots[0].caption}
              </figcaption>
            </figure>

            {screenshots.length > 1 && (
              <ul class="mt-3 flex gap-2 overflow-x-auto pb-1">
                {screenshots.map((shot, index) => (
                  <li class="shrink-0">
                    <button
                      type="button"
                      data-gallery-thumb
                      data-src={shot.src}
                      data-alt={shot.alt}
                      data-caption={shot.caption ?? ""}
                      aria-label={`Show screenshot ${index + 1}: ${shot.alt}`}
                      aria-pressed={index === 0 ? "true" : "false"}
                      class="border-border aria-pressed:border-accent block size-16 overflow-hidden rounded border-2 opacity-70 transition hover:opacity-100 aria-pressed:opacity-100"
                    >
                      <img
                        src={shot.src}
                        alt=""
                        loading="lazy"
                        class="size-full object-cover"
                      />
                    </button>
                  </li>
                ))}
              </ul>
            )}
          </section>
        )
      }

      <div class="flex flex-col gap-4">
        <section class="border-border rounded-lg border p-4">
          <h2 class="mb-2 text-lg font-semibold">About</h2>
          {
            hasBody ? (
              <div class="app-prose max-w-none text-sm">
                <Content />
              </div>
            ) : (
              <p class="text-sm">{description}</p>
            )
          }

          {
            stack.length > 0 && (
              <>
                <h2 class="mt-4 mb-2 text-lg font-semibold">Built with</h2>
                <ul class="flex flex-wrap gap-1.5">
                  {stack.map(tech => (
                    <li class="bg-muted/40 rounded px-2 py-0.5 text-sm">
                      {tech}
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </section>

        {
          links.length > 0 && (
            <ul class="flex flex-col gap-2">
              {links.map(link => (
                <li>
                  <a
                    href={link.href}
                    target={isExternal(link.href) ? "_blank" : undefined}
                    rel={
                      isExternal(link.href) ? "noopener noreferrer" : undefined
                    }
                    class="border-border hover:border-accent hover:text-accent flex items-center justify-between gap-2 rounded-lg border px-4 py-2 font-medium transition-colors"
                  >
                    <span>{link.label}</span>
                    {link.icon === "github" ? (
                      <IconGitHub class="size-5" aria-hidden="true" />
                    ) : (
                      <IconArrowRight
                        class="size-5 rtl:rotate-180"
                        aria-hidden="true"
                      />
                    )}
                  </a>
                </li>
              ))}
            </ul>
          )
        }

        {
          tags.length > 0 && (
            <ul class="flex flex-wrap gap-1.5" aria-label="Tags">
              {tags.map(tag => (
                <li class="text-xs opacity-75">#{tag}</li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  function initGallery() {
    document
      .querySelectorAll<HTMLElement>("[data-gallery]")
      .forEach(gallery => {
        const main = gallery.querySelector<HTMLImageElement>(
          "[data-gallery-main]"
        );
        const caption = gallery.querySelector<HTMLElement>(
          "[data-gallery-caption]"
        );
        const thumbs = gallery.querySelectorAll<HTMLButtonElement>(
          "[data-gallery-thumb]"
        );
        thumbs.forEach(thumb => {
          thumb.addEventListener("click", () => {
            if (!main) return;
            main.src = thumb.dataset.src ?? "";
            main.alt = thumb.dataset.alt ?? "";
            if (caption) {
              caption.textContent = thumb.dataset.caption ?? "";
              caption.classList.toggle("hidden", !thumb.dataset.caption);
            }
            thumbs.forEach(t =>
              t.setAttribute("aria-pressed", t === thumb ? "true" : "false")
            );
          });
        });
      });
  }

  document.addEventListener("astro:page-load", initGallery);
</script>
