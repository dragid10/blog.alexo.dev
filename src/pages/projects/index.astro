---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import { statusColors } from "@/utils/projectStatus";
import config from "@/config";

const allProjects = await getCollection("projects");

const sortProjects = (
  a: (typeof allProjects)[number],
  b: (typeof allProjects)[number]
) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  if (a.data.order != null && b.data.order != null)
    return a.data.order - b.data.order;
  if (a.data.order != null) return -1;
  if (b.data.order != null) return 1;
  return a.data.title.localeCompare(b.data.title);
};

const sections = [
  { status: "active", heading: "Active" },
  { status: "maintained", heading: "Maintained" },
  { status: "archived", heading: "Archived" },
]
  .map(section => ({
    ...section,
    projects: allProjects
      .filter(p => p.data.status === section.status)
      .sort(sortProjects),
  }))
  .filter(section => section.projects.length > 0);
---

<Layout
  title={`Projects | ${config.site.title}`}
  description="Alex Oladele's side projects and open source work."
>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout pb-8">
    <h1 class="text-2xl font-semibold sm:text-3xl">Projects</h1>
    <p class="mt-2 mb-8 italic">Things I've built and tinkered with.</p>

    {
      sections.map(section => (
        <section class="mb-10 last:mb-0">
          <h2 class="mb-4 text-xl font-semibold">{section.heading}</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {section.projects.map(project => (
              <div class="border-border hover:border-accent/40 relative rounded-lg border p-4 transition-colors">
                <div class="mb-2 flex items-start justify-between gap-2">
                  <h3 class="text-lg font-semibold">
                    <a
                      href={`/projects/${project.id}/`}
                      class="hover:text-accent after:absolute after:inset-0 after:z-[1] after:rounded-lg"
                    >
                      {project.data.title}
                    </a>
                  </h3>
                  <span
                    class:list={[
                      "shrink-0 rounded-full px-2 py-0.5 text-xs font-medium",
                      statusColors[project.data.status] ?? statusColors.active,
                    ]}
                  >
                    {project.data.status}
                  </span>
                </div>
                <p class="mb-3 text-sm opacity-75">
                  {project.data.description}
                </p>
                {project.data.tags.length > 0 && (
                  <div class="mb-3 flex flex-wrap gap-1.5">
                    {project.data.tags.map(tag => (
                      <span class="bg-muted/40 rounded px-1.5 py-0.5 text-xs">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
                <div class="relative z-10 flex w-fit gap-3 text-sm">
                  {project.data.repo && (
                    <a
                      href={project.data.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-accent hover:underline"
                    >
                      Source
                    </a>
                  )}
                  {project.data.demo && (
                    <a
                      href={project.data.demo}
                      target={
                        project.data.demo.startsWith("http")
                          ? "_blank"
                          : undefined
                      }
                      rel={
                        project.data.demo.startsWith("http")
                          ? "noopener noreferrer"
                          : undefined
                      }
                      class="text-accent hover:underline"
                    >
                      {project.data.demo.startsWith("/") ? "Read more" : "Demo"}
                    </a>
                  )}
                  {project.data.post && (
                    <a
                      href={project.data.post}
                      class="text-accent hover:underline"
                    >
                      Read more
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </main>
  <Footer />
</Layout>
